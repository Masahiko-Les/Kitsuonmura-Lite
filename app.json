{
  "expo": {
    "name": "吃音村Lite",
    "slug": "kitsuonmura-lite",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kitsuonmuralite",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f6efe1",
    "ios": {
      "bundleIdentifier": "com.masahikofujita.kitsuonmuralite",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "ja",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f5e8cc",
          "image": "./assets/images/facilities/garden.png",
          "imageWidth": 220
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "06b247c2-d937-4f24-8d54-cddaf32e60a4"
      }
    }
  }
}
